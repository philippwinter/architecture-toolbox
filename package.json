{
  "name": "architecture-toolbox",
  "version": "0.0.2",
  "private": true,
  "description": "A growing collection of browser-based enterprise architecture tools.",
  "type": "module",
  "workspaces": [
    "tools/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "npm run dev --workspace @architecture-toolbox/capability-map-studio",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @architecture-toolbox/capability-map-studio --",
    "build": "npm run build --workspaces --if-present",
    "build:standalone": "npm run build:standalone --workspace @architecture-toolbox/capability-map-studio",
    "build:pages": "npm run build:pages --workspace @architecture-toolbox/capability-map-studio && node scripts/assemble-pages.mjs",
    "verify:standalone": "node scripts/verify-standalone.mjs",
    "verify:pages": "node scripts/verify-pages.mjs"
  }
}
