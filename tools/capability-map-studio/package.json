{
  "name": "@architecture-toolbox/capability-map-studio",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages",
    "build:standalone": "tsc -b && vite build --mode standalone",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:standalone && playwright test"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/lint": "6.9.7",
    "@uiw/react-codemirror": "4.25.11",
    "@xyflow/react": "12.11.2",
    "jspdf": "4.2.1",
    "lucide-react": "1.24.0",
    "pptxgenjs": "4.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "svg2pdf.js": "2.7.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "jszip": "3.10.1",
    "pdfjs-dist": "6.2.108",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
